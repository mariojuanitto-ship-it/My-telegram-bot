# Railway sets PORT automatically; use 8080 for local runs
PORT=8080

# Required secret from @BotFather
TELEGRAM_BOT_TOKEN=put-your-bot-token-here

# Optional admin account used by the bot (numeric Telegram user ID)
TELEGRAM_ADMIN_ID=8487503078

# Use a Railway Volume mounted at /data to keep users and listings after redeploys
RP_BOT_DATA_FILE=/data/rp-bot.json

# Optional logging/runtime settings
NODE_ENV=production
LOG_LEVEL=info

# PostgreSQL is the primary persistent store when configured.
# The bot creates table rp_game_state automatically and keeps the full game state there.
# If DATABASE_URL is absent, it falls back to RP_BOT_DATA_FILE.
# Create a Neon project: https://console.neon.tech/app/projects/new
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
